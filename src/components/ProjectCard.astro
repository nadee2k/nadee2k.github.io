---
import type { CollectionEntry } from "astro:content";
import { tracks } from "../data/tracks";

interface Props {
  project: CollectionEntry<"projects">;
  /** Render the stack chips and buttons (home page) vs. a compact variant. */
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { data } = project;
const track = tracks[data.track];
const href = `/projects/${project.id.replace(/\.(md|mdx)$/, "")}/`;
---

<article
  class="card card--interactive card--pad"
  style={`--card-accent:${track.color}`}
>
  <header class="pc__head">
    <span class={`badge ${track.badge}`}>{track.short}</span>
    {
      data.period && (
        <span class="pc__period">{data.period}</span>
      )
    }
  </header>

  <h3 class="pc__title">
    <a href={href}>{data.title}</a>
  </h3>

  <p class="pc__summary">{data.summary}</p>

  {
    data.metrics.length > 0 && (
      <ul class="pc__metrics">
        {data.metrics.slice(0, compact ? 1 : 2).map((metric) => (
          <li>
            <span class="pc__metric-value">{metric.value}</span>
            <span class="pc__metric-label">{metric.label}</span>
          </li>
        ))}
      </ul>
    )
  }

  {!compact && (
    <ul class="chip-row pc__stack">
      {data.stack.slice(0, 6).map((item) => (
        <li>
          <span class="chip">{item}</span>
        </li>
      ))}
      {data.stack.length > 6 && <li><span class="chip">+{data.stack.length - 6}</span></li>}
    </ul>
  )}

  <footer class="pc__foot">
    <a class="btn btn--quiet btn--sm" href={href}>Case study</a>
    {
      data.repoUrl && (
        <a
          class="btn btn--quiet btn--sm"
          href={data.repoUrl}
          target="_blank"
          rel="noopener"
        >
          Code
        </a>
      )
    }
    {
      data.demoUrl && (
        <a
          class="btn btn--ghost btn--sm"
          href={data.demoUrl}
          target="_blank"
          rel="noopener"
        >
          Live demo
        </a>
      )
    }
  </footer>
</article>

<style>
  .pc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pc__period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .pc__title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .pc__title a {
    color: var(--text);
  }

  .pc__title a:hover {
    color: var(--card-accent);
    text-decoration: none;
  }

  .pc__summary {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .pc__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--border);
  }

  .pc__metric {
    display: flex;
    flex-direction: column;
  }

  .pc__metric-value {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--card-accent);
    line-height: 1.2;
  }

  .pc__metric-label {
    font-size: 0.72rem;
    color: var(--text-subtle);
  }

  .pc__stack {
    margin-top: -0.25rem;
  }

  .pc__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }
</style>