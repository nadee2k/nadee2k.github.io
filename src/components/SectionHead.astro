---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  center?: boolean;
  as?: "h1" | "h2";
}

const { eyebrow, title, lede, center = false, as: Tag = "h2" } = Astro.props;
---

<div class:list={["section-head", center && "section-head--center"]}>
  <span class="eyebrow">{eyebrow}</span>
  <Tag class="section-title">{title}</Tag>
  {lede && <p class="section-lede">{lede}</p>}
</div>