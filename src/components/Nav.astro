---
import { site, navLinks } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith("/") && path.startsWith(href) && href !== "/";
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href="/">
      <span class="nav__mark" aria-hidden="true">{site.initials}</span>
      <span class="nav__brand-text">
        <span class="nav__name">{site.shortName}</span>
        <span class="nav__role">{site.role}</span>
      </span>
    </a>

    <nav class="nav__links" data-nav-menu aria-label="Primary">
      <ul class="nav__list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/projects" data-nav-link aria-current={isActive("/projects") ? "page" : undefined}>
            All Projects
          </a>
        </li>
      </ul>
      <a class="btn btn--primary btn--sm nav__cta" href={site.resume} download>
        Download Résumé
      </a>
    </nav>

    <button
      class="nav__toggle"
      data-nav-toggle
      type="button"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 1000;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    background: rgba(8, 12, 24, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .nav[data-scrolled] {
    background: rgba(5, 8, 15, 0.92);
    border-bottom-color: var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    text-decoration: none;
  }

  .nav__brand:hover {
    text-decoration: none;
  }

  .nav__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--accent), var(--track-ml));
    color: #04121d;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .nav__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .nav__name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav__role {
    font-size: 0.72rem;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .nav__list a {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.35rem;
    position: relative;
    transition: color var(--dur) var(--ease);
  }

  .nav__list a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav__list a[aria-current] {
    color: var(--accent);
  }

  .nav__list a[aria-current]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .nav__toggle {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1px solid var(--border);
    place-items: center;
  }

  .nav__toggle span,
  .nav__toggle span::before,
  .nav__toggle span::after {
    display: block;
    width: 17px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform var(--dur) var(--ease);
  }

  .nav__toggle span {
    position: relative;
  }

  .nav__toggle span::before,
  .nav__toggle span::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav__toggle span::before {
    top: -6px;
  }

  .nav__toggle span::after {
    top: 6px;
  }

  .nav__toggle[aria-expanded="true"] span {
    background: transparent;
  }

  .nav__toggle[aria-expanded="true"] span::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__toggle[aria-expanded="true"] span::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 940px) {
    .nav__toggle {
      display: grid;
    }

    .nav__links {
      position: fixed;
      inset: var(--nav-height) 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1.25rem var(--gutter) 1.75rem;
      background: rgba(5, 8, 15, 0.98);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      display: none;
    }

    .nav__links[data-open] {
      display: flex;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__list a {
      display: block;
      padding-block: 0.8rem;
      font-size: var(--text-base);
      border-bottom: 1px solid var(--border);
    }

    .nav__list a[aria-current]::after {
      display: none;
    }

    .nav__cta {
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .nav__role {
      display: none;
    }
  }
</style>