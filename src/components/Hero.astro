---
import { Image } from "astro:assets";
import { site, headlineMetrics, socials } from "../data/site";
import profile from "../assets/profile.png";

const icons: Record<string, string> = {
  github: "M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z",
  linkedin:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z",
  mail: "M2 4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H2Zm.7 2h18.6L12 12.9 2.7 6Zm-.7.9V18h20V6.9l-10 7-10-7Z",
};
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <h1 class="hero__title">
        Data &amp; AI Engineer building
        <span class="hero__accent">data platforms and explainable ML.</span>
      </h1>

      <p class="hero__lede">{site.tagline}</p>

      <ul class="hero__metrics">
        {
          headlineMetrics.map((metric) => (
            <li class="hero__metric">
              <a
                class="hero__metric-link"
                href={metric.href}
                aria-label={`${metric.value} ${metric.label}; view case study`}
              >
                <span class="hero__metric-value">{metric.value}</span>
                <span class="hero__metric-label">{metric.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="btn-row hero__actions">
        <a class="btn btn--primary" href={site.resume} download>
          Download Résumé
        </a>
        <a class="btn btn--ghost" href="#projects">View Projects</a>
        <a class="btn btn--quiet" href={site.github} target="_blank" rel="noopener">
          GitHub
        </a>
      </div>
    </div>

    <div class="hero__aside">
      <div class="hero__photo-frame">
        <Image
          src={profile}
          alt={`Portrait of ${site.name}, ${site.role}`}
          widths={[240, 320, 420]}
          sizes="(max-width: 940px) 200px, 320px"
          loading="eager"
          decoding="async"
        />
      </div>

      <ul class="hero__socials">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.icon === "mail" ? undefined : "_blank"}
                rel="noopener"
                aria-label={social.label}
                title={social.label}
              >
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path d={icons[social.icon]} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: calc(var(--nav-height) + clamp(3rem, 8vw, 6rem))
      clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -40% 30% 40% -10%;
    background:
      radial-gradient(
        closest-side,
        rgba(56, 189, 248, 0.16),
        transparent 70%
      ),
      radial-gradient(
        closest-side,
        rgba(167, 139, 250, 0.14),
        transparent 70%
      );
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: -1;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid var(--accent-border);
    background: var(--accent-dim);
    color: var(--accent-text);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.2);
    flex-shrink: 0;
  }

  .hero__title {
    font-size: var(--text-3xl);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .hero__accent {
    display: block;
    background: linear-gradient(100deg, var(--accent) 10%, var(--track-ml) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    margin-top: 1.35rem;
    max-width: 54ch;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .hero__metrics {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: clamp(1rem, 3vw, 2.25rem);
    justify-content: start;
    list-style: none;
    padding: 1.5rem 0 0;
    margin-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .hero__metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__metric-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: inherit;
    text-decoration: none;
  }

  .hero__metric-link:hover {
    text-decoration: none;
  }

  .hero__metric-link:hover .hero__metric-value {
    color: var(--accent-text);
  }

  .hero__metric-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
  }

  .hero__metric-label {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .hero__actions {
    margin-top: 2rem;
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero__photo-frame {
    padding: 0.65rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(150deg, var(--accent), var(--track-ml));
    box-shadow: var(--shadow-lg);
  }

  .hero__photo-frame :global(img) {
    width: 260px;
    height: 260px;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 4px);
    background: var(--bg-sunken);
  }

  .hero__socials {
    display: flex;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
  }

  .hero__socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .hero__socials a:hover {
    color: var(--accent);
    border-color: var(--accent-border);
    transform: translateY(-2px);
    text-decoration: none;
  }

  @media (max-width: 940px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .hero__aside {
      order: -1;
      align-items: flex-start;
    }

    .hero__photo-frame :global(img) {
      width: 130px;
      height: 130px;
    }

    .hero__metrics {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 1.5rem;
    }
  }
</style>