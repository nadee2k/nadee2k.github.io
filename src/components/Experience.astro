---
import { experience } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="experience">
  <div class="container">
    <SectionHead
      eyebrow="Experience"
      title="Work Experience"
      lede="Industry exposure alongside the academic work above."
    />

    <ol class="timeline">
      {
        experience.map((entry) => (
          <li class:list={["timeline__item", "card", "card--pad"]}>
            <header class="timeline__head">
              <div>
                <h3 class="timeline__role">{entry.role}</h3>
                <p class="timeline__org">{entry.org}</p>
              </div>
              <p class="timeline__period">{entry.period}</p>
            </header>

            <p class="timeline__summary">{entry.summary}</p>

            <ul class="timeline__bullets">
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>

            {entry.todo && (
              <p class="timeline__todo" role="note">
                Placeholder — replace with the real internship details.
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    max-width: 780px;
  }

  .timeline__item {
    position: relative;
  }

  .timeline__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .timeline__role {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .timeline__org {
    color: var(--accent);
    font-size: var(--text-sm);
    margin-top: 0.15rem;
  }

  .timeline__period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
    white-space: nowrap;
  }

  .timeline__summary {
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }

  .timeline__bullets {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .timeline__bullets li + li {
    margin-top: 0.4rem;
  }

  .timeline__todo {
    margin-top: 1.15rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px dashed rgba(251, 191, 36, 0.45);
    background: rgba(251, 191, 36, 0.07);
    color: #fcd34d;
    font-size: var(--text-xs);
  }
</style>