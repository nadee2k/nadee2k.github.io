---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <Nav />
  <main id="main" class="nf">
    <div class="container nf__inner">
      <p class="nf__code">404</p>
      <h1 class="nf__title">This page doesn't exist</h1>
      <p class="nf__text">
        The link may be out of date. Everything on this site is reachable from the home
        page or the projects index.
      </p>
      <div class="btn-row nf__actions">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--ghost" href="/projects">Browse projects</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .nf {
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding-block: calc(var(--nav-height) + 3rem) 4rem;
  }

  .nf__inner {
    text-align: center;
    max-width: 480px;
  }

  .nf__code {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 500;
    line-height: 1;
    background: linear-gradient(100deg, var(--accent), var(--track-ml));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nf__title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-block: 1rem 0.75rem;
  }

  .nf__text {
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .nf__actions {
    justify-content: center;
  }
</style>